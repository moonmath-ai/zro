{
  "name": "zro",
  "publisher": "moonmath-ai",
  "displayName": "ZRO",
  "description": "Use ZRO models as a Copilot Chat model provider in VS Code.",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonmath-ai/zro.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "zro",
        "displayName": "ZRO",
        "managementCommand": "zro.manage"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zro-sidebar",
          "title": "ZRO",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "zro-sidebar": [
        {
          "type": "webview",
          "id": "zro.dashboardView",
          "name": "Dashboard",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "zro.manage",
        "title": "ZRO: Enter API key",
        "category": "ZRO"
      },
      {
        "command": "zro.login",
        "title": "Sign in with browser",
        "category": "ZRO"
      },
      {
        "command": "zro.dashboard",
        "title": "Dashboard",
        "category": "ZRO",
        "icon": "$(dashboard)"
      },
      {
        "command": "zro.configureExtensions",
        "title": "Configure in other extensions",
        "category": "ZRO"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zro.dashboard",
          "when": "view == zro.dashboardView",
          "group": "navigation@1"
        },
        {
          "command": "zro.login",
          "when": "view == zro.dashboardView",
          "group": "zro@1"
        },
        {
          "command": "zro.manage",
          "when": "view == zro.dashboardView",
          "group": "zro@2"
        },
        {
          "command": "zro.configureExtensions",
          "when": "view == zro.dashboardView",
          "group": "zro@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx @vscode/vsce package --no-dependencies --baseContentUrl https://github.com/moonmath-ai/zro/blob/main/vscode-extension --baseImagesUrl https://github.com/moonmath-ai/zro/raw/main/vscode-extension",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
